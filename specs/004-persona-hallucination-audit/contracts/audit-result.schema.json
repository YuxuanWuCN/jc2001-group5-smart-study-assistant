{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jc2001.group5.local/schemas/audit-result.schema.json",
  "title": "Hallucination Audit Verdict",
  "description": "Strict schema for reports/audit/verdict.json. Generated by scripts/audit_hallucination_l1_l3.py and jointly constrained by the speckit 004 audit workflow and the report claim contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_level",
    "verdict_rationale",
    "persona_level_min",
    "l1",
    "l2",
    "l3",
    "l4",
    "claim_matrix",
    "env_fingerprint",
    "determinism_check",
    "outstanding_reviews"
  ],
  "properties": {
    "verdict_level": {
      "type": "string",
      "enum": ["V0", "V1", "V2", "V3"],
      "description": "Must be derived automatically from evidence; manual entry is forbidden. V0 = not measured; V1 = offline L1-L3 only; V2 = V1 + online control with CI; V3 = V2 + user-side benefit (unreachable under this specification)"
    },
    "verdict_rationale": {
      "type": "string",
      "minLength": 20,
      "description": "A paragraph explaining why this is the current level; must name which piece of evidence is missing to reach the next level"
    },
    "persona_level_min": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3"],
      "description": "The worst evidence level among the core pain-point assertions of the three Personas"
    },
    "l1": { "$ref": "#/definitions/layerReport" },
    "l2": { "$ref": "#/definitions/layerReport" },
    "l3": { "$ref": "#/definitions/layerReport" },
    "l4": { "$ref": "#/definitions/layerReport" },
    "claim_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_sentences", "forbidden_sentences", "banned_terms_found"],
      "properties": {
        "allowed_sentences": { "type": "array", "items": { "type": "string" } },
        "forbidden_sentences": { "type": "array", "items": { "type": "string" } },
        "banned_terms_found": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "file", "line"],
            "properties": {
              "term": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "env_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "pandas_version",
        "git_commit",
        "branch",
        "timestamp_utc",
        "host_os"
      ],
      "properties": {
        "python_version": { "type": "string" },
        "pandas_version": { "type": "string" },
        "git_commit": { "type": "string" },
        "branch": { "type": "string" },
        "timestamp_utc": { "type": "string", "format": "date-time" },
        "host_os": { "type": "string" }
      }
    },
    "determinism_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_1_hash", "run_2_hash", "identical"],
      "properties": {
        "run_1_hash": { "type": "string", "minLength": 64 },
        "run_2_hash": { "type": "string", "minLength": 64 },
        "identical": { "type": "boolean", "const": true }
      },
      "description": "The SHA-256 of two independent runs must match (identical=true), otherwise the audit is not reproducible"
    },
    "outstanding_reviews": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All finding_ids with human_verdict=PENDING. When non-empty, verdict_level must not be higher than V1"
    }
  },
  "definitions": {
    "layerReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "denominator", "numerator", "rate", "coverage", "status"],
      "properties": {
        "layer": {
          "type": "string",
          "enum": ["L1_content", "L2_attribution", "L3_leakage", "L4_reasoning"]
        },
        "denominator": { "type": "integer", "minimum": 0 },
        "numerator": { "type": "integer", "minimum": 0 },
        "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": {
          "type": "string",
          "enum": ["measured", "skipped", "na_no_generation_face"],
          "description": "na_no_generation_face is used for L4 on the offline path: when the denominator is 0, rate must be null rather than 0"
        },
        "ci_low": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ci_high": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ci_method": { "type": ["string", "null"], "enum": ["wilson_95", null] },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "na_no_generation_face" } } },
          "then": {
            "properties": {
              "denominator": { "const": 0 },
              "rate": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "measured" } } },
          "then": {
            "properties": {
              "denominator": { "type": "integer", "minimum": 1 },
              "rate": { "type": "number" }
            }
          }
        }
      ]
    }
  }
}
