# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets (CRITICAL for Academic Integrity)
.env
*.local.env
.env.*
!.env.example

# Binary archives that may embed credential snapshots.
# The legacy PoC archive and the GraphRAG prototype archive were quarantined on
# 2026-10-25 and 2026-10-29: both carried literal API keys from the prototype
# phase. Rebuild any release archive from the credential-remediated HEAD and run
# a secret scan (0 hits) before distribution.
*.zip
!reports/ui-design/assets/*.zip

# IDE & Editor Specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# OS / Scratch / Temporary Files
*.tmp
*.log
.system_generated/
scratch/

# Node / Frontend Caches (if any)
node_modules/
npm-debug.log*

# Scratch & scraped files
scraped_*
.agents/

# Course slides in root directory (keep repo clean and lightweight)
/*.pdf
/*.txt
!/requirements.txt
!/docs/course/*.txt
/docs/course/*.pdf
!/reports/*.pdf

# Root-level PPT unpack scratch (throwaway scripts, dumped text & extracted assets)
# Per Phase 2 governance: no temporary debugging scripts committed to root directories.
/_extract_images.py
/_extract_week5.py
/_unpack.py
/_week5_dump.txt
/_week5_slides/
/_week5_unpacked/

