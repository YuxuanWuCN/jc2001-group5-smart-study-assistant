%% Figure 4.1 — Four-layer architecture and single-port deployment
%% JC2001 Group 5 / StudyGraph Smart Study Assistant / Chapter 4.1.1
%% 
%% Three facts the reviewer must see (hard requirement of task package section 4.1.1):
%%   1. Only one process and one port -- uvicorn serves both the API and the static files;
%%   2. The frontend and the API share an origin -- hence CORS is unnecessary on the production path (the wildcard CORS setting is only for local debugging);
%%   3. No database -- Layer 4 is a read-only Python source module, a direct consequence of AD-03.
%% 
%% Figures verified (develop@626d467):
%%   frontend: index.html 40 KB · app.js 167 KB · style.css 50 KB
%%   backend/app/routers: 3 modules (health / quiz / diagnose) · 4 endpoints
%%   backend/app/services: 3 modules (diagnostic / quiz / llm_diagnostics)
%%   backend/app/models: 3 modules (common / diagnose / quiz)
%%   backend/app/data/seed_questions.py: 657 lines · 12 questions · 4 subjects · 36 traps
%% 
%% Rendering notes (measured on Mermaid 11):
%%   1. ASCII parentheses must not appear inside node labels -- they delimit flowchart node shapes; use full-width parentheses instead;
%%   2. A comment line must not be just "%%"; write "%% " instead (two percent signs alone break flowchart preprocessing);
%%   3. Components within a layer are joined into one row by invisible links and layers are connected by directed edges, producing the "horizontal layer band" effect.
flowchart TB
    Deploy["Single-process uvicorn :8000<br/><i>StaticFiles html=True mounted at the root path</i><br/><b>Single process · single port · frontend and API share an origin</b>"]

    subgraph L1["Layer 1 · Presentation (frontend/ · zero-build native ES6)"]
        direction LR
        F1["index.html<br/><i>40 KB · single-page shell</i>"]
        F2["app.js<br/><i>167 KB · views and diagnosis interaction</i>"]
        F3["style.css<br/><i>50 KB · CSS variables · dual theme</i>"]
        F4["localStorage<br/><i>Answer records</i>"]
        F1 ~~~ F2 ~~~ F3 ~~~ F4
    end

    subgraph L2["Layer 2 · API / Interface (backend/app/routers · 3 routers)"]
        direction LR
        E1["GET /api/health<br/>GET /api/health/llm"]
        E2["GET /api/quiz<br/><i>subject and limit</i>"]
        E3["POST /api/diagnose<br/><i>Pydantic validation entry point</i>"]
        E1 ~~~ E2 ~~~ E3
    end

    subgraph L3["Layer 3 · Domain Services (backend/app/services · 3 services)"]
        direction LR
        S1["quiz_service<br/><i>Question lookup · subject normalisation</i>"]
        S2["diagnostic_service<br/><i>Option-level trap table lookup</i>"]
        S3["llm_diagnostics<br/><i>Failure classification · hint enhancement</i>"]
        S1 ~~~ S2 ~~~ S3
    end

    subgraph L4["Layer 4 · Data / Knowledge (backend/app/data · no database)"]
        direction LR
        D1[("seed_questions.py<br/><i>657 lines · 12 questions · 4 subjects · 36 traps</i>")]
        D2["Pydantic models<br/><i>QuizItem / OptionItem / TrapDetail</i>"]
        D1 ~~~ D2
    end

    Deploy -.->|"Mounts static assets"| L1
    L1 -->|"HTTP / JSON <b>same origin</b>"| L2
    L2 -->|"In-process service calls"| L3
    L3 -->|"In-memory dictionary lookup · zero network I/O"| L4

    style Deploy fill:#fff7ed,stroke:#c2410c,stroke-width:2.5px
    style L1 fill:#eff6ff,stroke:#1d4ed8,stroke-width:2px
    style L2 fill:#f0fdf4,stroke:#15803d,stroke-width:2px
    style L3 fill:#fefce8,stroke:#a16207,stroke-width:2px
    style L4 fill:#faf5ff,stroke:#7e22ce,stroke-width:2px
