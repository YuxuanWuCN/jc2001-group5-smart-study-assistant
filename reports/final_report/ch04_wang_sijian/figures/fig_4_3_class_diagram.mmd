%%{init: {"class": {"hideEmptyMembersBox": true}}}%%
%% Figure 4.3 — UML Class Diagram (domain model)
%% JC2001 Group 5 / StudyGraph Smart Study Assistant / Chapter 4.3
%% 
%% This is the only brand-new technical diagram in this chapter (the official brief explicitly requires class diagrams).
%% Classes and attributes correspond exactly to the actual definitions in backend/app/models/quiz.py (develop@626d467).
%% 
%% Design insight (must be stated in section 4.3.2):
%%   Traps are attached to options, not to questions.
%%   The same wrong option carries different misconceptions in different contexts; binding traps to options reduces "diagnosis" to
%%   a single foreign-key lookup (traps[option.trap_id]) rather than an inference step.
%%   This modelling decision (AD-04) is the precondition for making the whole diagnosis algorithm deterministic.
%% 
%% Measured cardinalities: QuizItem 12 · OptionItem 48 · TrapDetail 36 · GraphNode 60
classDiagram
    direction LR

    class QuizItem {
        +str id
        +str subject
        +str difficulty
        +str tag
        +str stem
        +str explanation
        +str answer
        +str trap_hint
        +str socratic_prompt
        +get_correct_option()
        +deduce_answer_key()
    }

    class OptionItem {
        +str key
        +str text
        +bool is_correct
        +str trap_id
        +normalize_keys()
        +sync_aliases()
    }

    class TrapDetail {
        +str title
        +str desc
        +str prereq
        +str radar_hit
        +normalize_keys()
        +sync_aliases()
    }

    class RadarDimension {
        <<enumeration>>
        recall
        boundary
        trapDefense
        synthesis
        precision
    }

    class GraphData {
        +str title
        +list nodes
        +list edges
    }

    class GraphNode {
        +str id
        +str label
        +str type
        +float x
        +float y
    }

    class GraphEdge {
        +str from_node
        +str to_node
        +str label
    }

    QuizItem "1" *-- "4" OptionItem : options
    QuizItem "1" o-- "0..1" GraphData : graph
    QuizItem "1" o-- "0..*" TrapDetail : traps[dict]
    OptionItem "0..*" --> "0..1" TrapDetail : trap_id (wrong options only)
    TrapDetail "1" --> "1" RadarDimension : radar_hit

    GraphData "1" *-- "0..*" GraphNode : nodes
    GraphData "1" *-- "0..*" GraphEdge : edges

    note for OptionItem "Traps attach to options, not questions:<br/>a single lookup of traps[option.trap_id] completes the diagnosis"
    note for RadarDimension "5 dimensions rendered as the learning radar chart by frontend/app.js"
