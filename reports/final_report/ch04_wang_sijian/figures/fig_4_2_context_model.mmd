%% Figure 4.2 — System Context Model
%% JC2001 Group 5 / StudyGraph Smart Study Assistant / Chapter 4.2.1
%% 
%% Design constraints (do not violate):
%%   1. Three external entities are present as the task package requires: Student (primary actor), Instructor / Marker
%%      (secondary beneficiary, does not operate the system directly), Neo4j AuraDB (offline evaluation only).
%%   2. Neo4j must be drawn with a dashed line and explicitly labelled "offline evaluation only" -- this is the
%%      visual evidence for AD-05. It is not part of the online demo path, so the demo still works offline.
%%   3. Qwen-Turbo is marked [Optional]: enabled by an environment variable only when generating a hint after a wrong answer,
%%      as a hint enhancer outside the diagnosis decision path (consistent with Figure 4.4).
%%   4. Code locations match the current implementation: backend/app/main.py, backend/app/data/seed_questions.py.
%%   5. Solid bidirectional = synchronous request/response; dashed unidirectional = one-way dependency or indirect interaction.
%% 
%% Note: ASCII parentheses must not appear inside node labels (they delimit flowchart node shapes and
%%       would break parsing); every label in this figure is a quoted string.
flowchart TB
    subgraph Actors["External Actors"]
        direction LR
        Student(["University Student<br/><i>primary actor · web browser</i>"])
        Teacher(["Course Instructor / Marker<br/><i>secondary beneficiary · no direct operation</i>"])
    end

    subgraph Boundary["StudyGraph System Boundary - Smart Study Assistant"]
        direction LR
        Frontend["SPA Frontend Console<br/><i>HTML5 / CSS3 / Vanilla ES6</i><br/><i>frontend/index.html + app.js</i>"]
        Backend["FastAPI Business Hub<br/><i>Python 3.10+ / modular layering</i><br/><i>backend/app/main.py</i>"]
        Store[("Curated Question Bank and Prerequisite Knowledge<br/><i>backend/app/data/seed_questions.py</i><br/><i>12 questions · 4 subjects · 36 traps</i>")]
        Frontend <-->|"RESTful API /api/*<br/>same origin · single port"| Backend
        Backend <-->|"Reads questions and trap mappings"| Store
    end

    DB[("Neo4j AuraDB<br/><i>Topic / misconception topology graph</i><br/><b>offline evaluation only</b>")]
    LLM["Alibaba Cloud Qwen-Turbo<br/><i>Generates hints after wrong answers [Optional]</i>"]

    Student <-->|"HTTPS / JSON<br/>human-computer interaction"| Frontend
    Teacher -.->|"Reviews deliverables: report and PoC<br/>no direct API calls"| Boundary
    Backend -.->|"Cypher queries<br/>[offline evaluation script · no online dependency]"| DB
    Backend -.->|"Compatible-protocol calls<br/>[Optional · enabled by environment variable]"| LLM

    style Student fill:#fff7ed,stroke:#c2410c,stroke-width:2px,color:#7c2d12
    style Teacher fill:#f5f3ff,stroke:#6d28d9,stroke-width:2px,color:#4c1d95
    style Frontend fill:#e8f0fe,stroke:#1a56db,stroke-width:2px
    style Backend fill:#e8f0fe,stroke:#1a56db,stroke-width:2px
    style Store fill:#ecfdf5,stroke:#047857,stroke-width:2px
    style DB fill:#f3f4f6,stroke:#4b5563,stroke-width:2px,stroke-dasharray:5 4
    style LLM fill:#fff1f2,stroke:#be123c,stroke-width:2px,stroke-dasharray:5 4
    style Boundary fill:#f8fafc,stroke:#334155,stroke-width:2px
    style Actors fill:#fafafa,stroke:#78716c,stroke-width:1.5px,stroke-dasharray:4 3
