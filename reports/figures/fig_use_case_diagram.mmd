        UC03["<b>UC-03 Search Knowledge Points</b><br/>[Implemented]"]
        UC01["<b>UC-01 Intelligent Wrong-Answer Troubleshooting Diagnosis</b><br/>[Implemented]"]
        UC04["<b>UC-04 Browse Graph Topology Associations</b><br/>[Implemented]"]
        UC08["<b>UC-08 Socratic Tutor Follow-up</b><br/>[Implemented - Local First]"]
        UC07["<b>UC-07 Adaptive Reinforcement with Variant Questions</b><br/>[Planned]"]
        UC06["<b>UC-06 External Model Enhancement</b><br/>[Optional - Planned]"]
    end

    Student --> UC02
