%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 45, "rankSpacing": 75, "padding": 14}}}%%
%% 图 2：全局 UML 用例图 (Global Use Case Diagram)
%% JC2001 Group 5 / 智学罗盘 Smart Study Assistant
%% 说明：
%%   1. <<include>> / <<extend>> 刻型以 ASCII 尖括号渲染。Mermaid 的 HTML 标签
%%      消毒器会把边标签中的 <...> 当作未知标签剥离，因此源码使用等宽占位符
%%      [[ST_INCLUDE]] / [[ST_EXTEND]]，由 tools/render_figures.mjs 在导出时
%%      替换为真实刻型并同步修正标签宽度；直接用 mermaid.live 预览时请手工替换。
%%   2. 关系方向遵循 UML 2.5 规范：包含关系 (<<include>>) 为基础用例 -> 被包含用例；
%%      扩展关系 (<<extend>>) 为扩展用例 -> 基础用例。
%%   3. 虚线框内为系统边界；状态标记见下。
%%      [已实现] 当前 PoC 已交付；[前端计算] 无后端端点；[规划中] 后续迭代。
flowchart LR
    Student(["在校大学生<br/>(Student)"])

    subgraph Core["智学罗盘核心功能域 (System Boundary)"]
        direction LR
        UC02["<b>UC-02 专项自测刷题</b><br/>[已实现]"]
        UC05["<b>UC-05 查看学情掌握度雷达</b><br/>[前端计算 · 无后端端点]"]
        UC03["<b>UC-03 检索考点知识点</b><br/>[已实现]"]
        UC01["<b>UC-01 错题智能排雷诊断</b><br/>[已实现]"]
        UC04["<b>UC-04 浏览图谱拓扑关联</b><br/>[已实现]"]
        UC08["<b>UC-08 苏格拉底导师追问</b><br/>[已实现 · 本地优先]"]
        UC07["<b>UC-07 变式题自适应强化</b><br/>[规划中]"]
        UC06["<b>UC-06 外部模型增强</b><br/>[可选 · 规划中]"]
    end

    Student --> UC02
    Student --> UC05
    Student --> UC03

    UC02 -. "[[ST_INCLUDE]]" .-> UC01
    UC03 -. "[[ST_INCLUDE]]" .-> UC04
    UC08 -. "[[ST_EXTEND]]" .-> UC01
    UC07 -. "[[ST_EXTEND]]" .-> UC01
    UC06 -. "[[ST_EXTEND]]" .-> UC01
    UC06 -. "[[ST_EXTEND]]" .-> UC08

    style Student fill:#fff7ed,stroke:#c2410c,stroke-width:2px,color:#7c2d12
    style Core fill:#f8fafc,stroke:#334155,stroke-width:2px
    style UC01 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC02 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC03 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC04 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC05 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC08 fill:#e8f0fe,stroke:#1a56db,stroke-width:2.5px
    style UC06 fill:#f3f4f6,stroke:#4b5563,stroke-width:2px,stroke-dasharray:4 3
    style UC07 fill:#f3f4f6,stroke:#4b5563,stroke-width:2px,stroke-dasharray:4 3
