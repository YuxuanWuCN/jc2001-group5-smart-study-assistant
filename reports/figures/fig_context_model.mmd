flowchart TB
    Student(["University Student (Student)<br/>'Web Browser Client'"])

    subgraph Boundary["Smart Study Assistant System Boundary (Smart Study Assistant)"]
        direction LR
        Frontend["SPA Frontend Console<br/><i>HTML5 / CSS3 / Vanilla JS</i><br/><i>frontend/index.html + app.js</i>"]
